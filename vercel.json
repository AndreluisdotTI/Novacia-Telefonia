{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "artifacts/novacia/public",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/page.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
